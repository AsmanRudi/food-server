{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "checkJs": false,
    "allowJs": true,
    "types": ["node"],
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "app.js",
    "app/**/*.js",
    "bin/**/*.js",
    "database/**/*.js",
    "middlewares/**/*.js",
    "scripts/**/*.js",
    "utils/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.js"
  ]
}